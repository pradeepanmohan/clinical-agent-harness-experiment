{
  "name": "clinical-agent-harness-experiment",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.1.2",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "sandcastle:issue": "tsx .sandcastle/run-issue.mts",
    "sandcastle:dry-run": "SANDCASTLE_DRY_RUN=1 tsx .sandcastle/run-issue.mts"
  },
  "devDependencies": {
    "@ai-hero/sandcastle": "0.10.0",
    "@eslint/js": "9.17.0",
    "eslint": "9.17.0",
    "globals": "15.14.0",
    "tsx": "4.21.0",
    "turbo": "2.3.3",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.2",
    "vitest": "2.1.8"
  }
}
